MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 54154882d25b3d24ca06a2081ee24550, type: 3}
  m_Name: The Locksmith's Widow
  m_EditorClassIdentifier: FateDeck.Runtime::FateDeck.Runtime.Run.EventDefinition
  _id:
    _value: 32c3f246038e43a1819364f094596729
  Intro: She polishes keys that no longer have doors. "He made every lock down here,"
    she says. "I sell what opens them."
  Options:
  - Label: 'Buy the spares (6g): 2 Keys'
    GoldCost: 6
    Effects:
    - rid: 3602687376965238882
    ResultText: Two brass teeth, still warm from the polishing cloth.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Ask her to read the wards (free flip)
    GoldCost: 0
    Effects: []
    ResultText: She turns your card over with a locksmith's care.
    FlipsFate: 1
    RitualOutcomes:
    - Force: {fileID: 11400000, guid: 22c8642c4e977a64f8ab6ce6ea1c2373, type: 2}
      ResultText: '"Sturdy. Like him." She gifts you a Key.'
      Effects:
      - rid: 3602687376965238883
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: aea6d0b066f86d34bae7b403de17c40b, type: 2}
      ResultText: '"Lucky hands." Two Keys, free.'
      Effects:
      - rid: 3602687376965238884
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: 95d40b2e4f1510641b796a4fc25b9c97, type: 2}
      ResultText: '"One of his!" She weeps, and arms you: 2 Keys.'
      Effects:
      - rid: 3602687376965238885
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: d52a4e832d613db449228d57add91392, type: 2}
      ResultText: '"Oh. Oh no. Go. GO."'
      Effects:
      - rid: 3602687376965238886
      ClosesEvent: 1
    - Force: {fileID: 11400000, guid: b125add7e470ac947b01aa947da886cf, type: 2}
      ResultText: '"The wards are silent." She closes the case.'
      Effects: []
      ClosesEvent: 1
    Repeatable: 0
    ClosesEvent: 1
  - Label: Leave her be
    GoldCost: 0
    Effects: []
    ResultText: The polishing goes on.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  references:
    version: 2
    RefIds:
