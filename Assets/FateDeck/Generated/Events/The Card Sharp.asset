  m_Name: The Card Sharp
  m_EditorClassIdentifier: FateDeck.Runtime::FateDeck.Runtime.Run.EventDefinition
  _id:
    _value: c1d5365c01c7477c943117cc7245965c
  Intro: A gaunt figure fans a deck that looks suspiciously like yours. "Two cards,
    any suit, free of charge. I'll just slip in a little something of mine."
  Options:
  - Label: Take 2 Iron (he slips in 1 Doom)
    GoldCost: 0
    Effects:
    - rid: 3602687371046289843
    - rid: 3602687371046289844
    ResultText: Two Iron join your fate - and something colder slides in with them.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Take 2 Flame (he slips in 1 Doom)
    GoldCost: 0
    Effects:
    - rid: 3602687371046289845
    - rid: 3602687371046289846
    ResultText: Two Flame join your fate - and something colder slides in with them.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Take 2 Fortune (he slips in 1 Doom)
    GoldCost: 0
    Effects:
    - rid: 3602687371046289847
    - rid: 3602687371046289848
    ResultText: Two Fortune join your fate - and something colder slides in with
      them.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Walk away
    GoldCost: 0
    Effects: []
    ResultText: '"Pity. The house always slips one in eventually."'
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
