    - rid: 3602687400656503801
    - rid: 3602687400656503802
    ResultText: Two Flame join your fate - and something colder slides in with them.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Take 2 Fortune (he slips in 1 Debt)
    GoldCost: 0
    KeyCost: 0
    Effects:
    - rid: 3602687400656503803
    - rid: 3602687400656503804
    ResultText: Two Fortune join your fate - and something colder slides in with
      them.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Walk away
    GoldCost: 0
    KeyCost: 0
    Effects: []
    ResultText: '"Pity. The house always slips one in eventually."'
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
