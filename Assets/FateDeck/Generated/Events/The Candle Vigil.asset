  m_Script: {fileID: 11500000, guid: 54154882d25b3d24ca06a2081ee24550, type: 3}
  m_Name: The Candle Vigil
  m_EditorClassIdentifier: FateDeck.Runtime::FateDeck.Runtime.Run.EventDefinition
  _id:
    _value: a875f476296f4fcf95c83c5ce23f74da
  Intro: A hundred candles around a single unlit wick. Light it, and the flame reads
    whatever fate you feed it.
  Options:
  - Label: Light the wick (free flip)
    GoldCost: 0
    Effects: []
    ResultText: The flame gutters, unreadable.
    FlipsFate: 1
    RitualOutcomes:
    - Force: {fileID: 11400000, guid: db6a6c29ae0e45948b59992cb5e7f969, type: 2}
      ResultText: 'The flame ROARS approval: +5g and a Flame joins you.'
      Effects:
      - rid: 3602687376965238895
      - rid: 3602687376965238896
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: b360d1657d70238488946864f0b64a4c, type: 2}
      ResultText: 'The flame HOWLS: +8g and a Flame joins you.'
      Effects:
      - rid: 3602687376965238897
      - rid: 3602687376965238898
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: 22c8642c4e977a64f8ab6ce6ea1c2373, type: 2}
      ResultText: The wax sets iron-hard. An Iron joins your deck.
      Effects:
      - rid: 3602687376965238899
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: aea6d0b066f86d34bae7b403de17c40b, type: 2}
      ResultText: 'Molten gold beads on the wick: +10g.'
      Effects:
      - rid: 3602687376965238900
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: 96b672feb50046845ab3541624c206b3, type: 2}
      ResultText: 'The flame doubles, pays double: +6g.'
      Effects:
      - rid: 3602687376965238901
      ClosesEvent: 0
    - Force: {fileID: 11400000, guid: b125add7e470ac947b01aa947da886cf, type: 2}
      ResultText: The wick refuses. The vigil is over.
      Effects: []
      ClosesEvent: 1
    - Force: {fileID: 11400000, guid: d52a4e832d613db449228d57add91392, type: 2}
      ResultText: Every candle dies at once.
      Effects:
      - rid: 3602687376965238902
      ClosesEvent: 1
    Repeatable: 0
    ClosesEvent: 1
  - Label: Let it sleep
    GoldCost: 0
    Effects: []
    ResultText: The candles keep their own vigil.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
