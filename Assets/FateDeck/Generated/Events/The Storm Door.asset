  m_Name: The Storm Door
  m_EditorClassIdentifier: FateDeck.Runtime::FateDeck.Runtime.Run.EventDefinition
  _id:
    _value: d228d4a56952487d9d68ccd6d7833881
  Intro: A door stands open onto a hallway of weather. Lightning arcs politely around
    the frame. The storm wants into your deck.
  Options:
  - Label: 'Walk through (free): 1 Tempest and 1 Doom'
    GoldCost: 0
    Effects:
    - rid: 3602687376965238876
    - rid: 3602687376965238877
    ResultText: Thunder files itself between your cards. So does the fine print.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: 'Bribe the wind (10g): 1 Tempest, clean'
    GoldCost: 10
    Effects:
    - rid: 3602687376965238878
    ResultText: The storm pockets your coin and behaves.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Close the door
    GoldCost: 0
    Effects: []
    ResultText: The weather sighs.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
