  m_Name: The Beggar of Odds
  m_EditorClassIdentifier: FateDeck.Runtime::FateDeck.Runtime.Run.EventDefinition
  _id:
    _value: adfb9057b1074044a86427242a59d199
  Intro: A beggar sits cross-legged on a pile of losing tickets. "Ten gold," he says,
    "and I eat one of your Dooms. Market rate. No tricks."
  Options:
  - Label: Pay him
    GoldCost: 10
    Effects:
    - rid: 3602687371046289834
    ResultText: He swallows the Doom whole. It does not come back.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Refuse
    GoldCost: 0
    Effects: []
    ResultText: '"Suit yourself. Doom keeps its own books."'
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
