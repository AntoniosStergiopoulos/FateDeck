  m_Name: The Beggar of Odds
  m_EditorClassIdentifier: FateDeck.Runtime::FateDeck.Runtime.Run.EventDefinition
  _id:
    _value: a31fdf4ab1234b27aae6d83614c97ef0
  Intro: A beggar sits cross-legged on a pile of losing tickets. "Ten gold," he says,
    "and I eat one of your Debts. Market rate. No tricks."
  Options:
  - Label: Pay him
    GoldCost: 10
    KeyCost: 0
    Effects:
    - rid: 3602687399754203883
    ResultText: He swallows the Debt whole. It does not come back.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Refuse
    GoldCost: 0
    KeyCost: 0
    Effects: []
    ResultText: '"Suit yourself. Debt keeps its own books."'
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
