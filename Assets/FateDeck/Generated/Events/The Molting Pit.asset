  m_Name: The Molting Pit
  m_EditorClassIdentifier: FateDeck.Runtime::FateDeck.Runtime.Run.EventDefinition
  _id:
    _value: 2e4b33d552bd4b76a60ffb8b321f2432
  Intro: A pit of shed skins - old decks, old luck, old selves. Things left here
    stay left. The pit hums, patient.
  Options:
  - Label: 'Shed (free): exile 1 card from your discard'
    GoldCost: 0
    KeyCost: 0
    Effects:
    - rid: 3602687397376295461
    ResultText: The old law slides off you. The pit sighs contentedly.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: 'Deep molt (8g): exile 1 and heal 1 wound'
    GoldCost: 8
    KeyCost: 0
    Effects:
    - rid: 3602687397376295462
    - rid: 3602687397376295463
    ResultText: Something old leaves; something torn knits.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
  - Label: Stay in your skin
    GoldCost: 0
    KeyCost: 0
    Effects: []
    ResultText: The pit hums on.
    FlipsFate: 0
    RitualOutcomes: []
    Repeatable: 0
    ClosesEvent: 1
